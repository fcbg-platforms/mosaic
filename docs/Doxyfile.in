PROJECT_NAME     = "MOSAIC"
PROJECT_NUMBER   = @PROJECT_VERSION@
PROJECT_BRIEF    = "Multi-camera Observatory for Social & Activity Interaction Capture"
OUTPUT_DIRECTORY = @CMAKE_CURRENT_BINARY_DIR@/docs
INPUT            = @CMAKE_SOURCE_DIR@/src
RECURSIVE        = YES
EXTRACT_ALL      = NO
GENERATE_HTML    = YES
GENERATE_LATEX   = NO
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md
