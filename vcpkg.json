{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "mosaic",
  "version": "0.1.0",
  "dependencies": [
    "gtest",
    "opencv4",
    {
      "name": "ffmpeg",
      "features": ["x264"]
    }
  ],
  "features": {
    "lsl": {
      "description": "Lab Streaming Layer support for neuroscience data synchronisation",
      "dependencies": [
        "liblsl"
      ]
    }
  }
}
