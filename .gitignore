# Build artifacts
build/
out/
cmake-build-*/

# IDE project files
.vs/
.vscode/settings.json
.idea/
*.user
*.suo
CMakeCache.txt
CMakeFiles/

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb

# vcpkg installed
vcpkg_installed/

# Qt generated
*.qm
moc_*.cpp
ui_*.h
qrc_*.cpp

# macOS
.DS_Store

# Windows
Thumbs.db

# Python
.venv/
python/.venv/
__pycache__/
*.pyc

# Auto-downloaded face-detection model weights (analysis/facemask backends)
analysis/facemask/models/

# Auto-downloaded whisper/pyannote model weights (analysis/run_diarize.py,
# redirected here from the global ~/.cache/huggingface via HF_HOME)
analysis/diarize/models/

# Auto-downloaded MediaPipe FaceLandmarker + FER+ ONNX model weights
# (analysis/expression backend) — each plugin owns its own model cache
# rather than reaching into a sibling plugin folder (facemask/models/
# already has an identical face_landmarker.task; re-downloaded here too)
analysis/expression/models/

# Auto-downloaded MediaPipe FaceLandmarker weights (analysis/gaze backend,
# used by the Multi-Camera Gaze Fusion plugin) — same per-plugin-owns-its-
# cache convention as the entries above.
analysis/gaze/models/

# Auto-downloaded MediaPipe FaceLandmarker weights (analysis/rppg backend,
# used by the Remote Heart Rate plugin) — same per-plugin-owns-its-cache
# convention as the entries above.
analysis/rppg/models/

# Logs
*.log

# Recorded session data (not source)
recordings/

# Claude Code local tool config (machine-specific)
.claude/

# Generated documentation output (rebuild via MOSAIC_BUILD_DOCS)
docs/html/
# Non-portable, machine-specific Doxygen config (absolute paths) — Doxyfile.in
# is the real template-driven source, substituted at build time.
docs/Doxyfile
# autosummary-generated stub .rst files (regenerated on every Sphinx build)
docs/_autosummary/
# Sphinx build output (rebuild via `sphinx-build` / MOSAIC_BUILD_DOCS)
docs/_build/
build-docs/
